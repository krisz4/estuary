{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".env", "apps/*/.env", "packages/tsconfig/*.json"],
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "DATABASE_URL",
    "PORT",
    "HOST",
    "ALLOWED_ORIGINS",
    "ALLOW_SEED",
    "SEED_ON_START",
    "LOG_LEVEL",
    "DOCS_ENABLED",
    "BODY_LIMIT",
    "VITE_API_BASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!**/*.test.tsx"],
      // The tsbuildinfo is an output, not a side effect. `incremental: true` means
      // tsc decides whether to emit by comparing against it — so if turbo restores a
      // cached `dist` while the tsbuildinfo on disk says something else, tsc emits
      // nothing and the mismatch sticks. Caching the pair together keeps them honest.
      "outputs": ["dist/**", "node_modules/.cache/tsc/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": [],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
