{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "React 19 + Vite application",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "useDefineForClassFields": true,
    "types": ["vite/client"]
  }
}
