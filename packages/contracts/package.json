{
  "name": "@estuary/contracts",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Shared zod schemas, enums, and inferred types — the single source of truth for the API surface",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo node_modules/.cache",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@estuary/tsconfig": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
