{
  "name": "helpdesk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI task manager — monorepo root",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@helpdesk/api",
    "dev:web": "turbo run dev --filter=@helpdesk/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && pnpm typecheck:e2e",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:api": "turbo run test --filter=@helpdesk/api",
    "test:web": "turbo run test --filter=@helpdesk/web",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@helpdesk/contracts": "workspace:*",
    "@helpdesk/tsconfig": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
