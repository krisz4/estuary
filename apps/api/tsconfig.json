{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@helpdesk/tsconfig/node.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc/typecheck.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "vitest.globalSetup.ts"
  ]
}
