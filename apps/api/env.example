# apps/api — copy to `.env` and adjust. Keep in sync with
# docs/engineering/ENVIRONMENT_VARIABLES.md; every variable here is parsed by
# src/lib/env.ts, which is the only place in the codebase that reads process.env.

# SQLite file. Relative paths resolve from apps/api/prisma/, so this is
# apps/api/prisma/data/helpdesk.db. The file and its -wal/-shm siblings are gitignored.
DATABASE_URL="file:./data/helpdesk.db"

# API listen port.
PORT=4000

# Loopback for local development. There is no authentication in this app by
# design, so binding 0.0.0.0 on a laptop publishes full ticket CRUD to the LAN.
# The container overrides this to 0.0.0.0, which is where it is actually needed.
HOST=127.0.0.1

# development | test | production. Does NOT control seeding — see ALLOW_SEED.
NODE_ENV=development

# Comma-separated CORS allow-list. Four origins because a browser sees four:
# localhost and 127.0.0.1 are different origins, and 5173 (vite dev) and 4173
# (vite preview — the production build, and what Playwright's webServer runs)
# are different ports. Listing fewer is what made the preview build unable to
# reach the API.
#
# The Docker stack does not rely on this: nginx proxies /api/ to the API on the
# same origin, so nothing the app does is cross-origin there.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# `true` permits seeding even under NODE_ENV=production. The switch is this
# variable, not NODE_ENV, so the Docker image can ship demo data from a
# production build. Outside production no flag is needed. Seeding DELETES every
# ticket and comment first. Unset by default.
# ALLOW_SEED=true

# Container entrypoint only: seed after `migrate deploy`, but only when the
# ticket table is empty.
SEED_ON_START=false

# debug | info | warn | error
LOG_LEVEL=info

# Set false to hide Swagger UI at /docs. When false the router is never mounted
# and /docs is an ordinary 404 NOT_FOUND.
DOCS_ENABLED=true

# Over-limit request bodies become PAYLOAD_TOO_LARGE.
BODY_LIMIT=1mb
