# apps/api — copy to `.env` and adjust. Keep in sync with
# docs/engineering/ENVIRONMENT_VARIABLES.md; every variable here is parsed by
# src/lib/env.ts, which is the only place in the codebase that reads process.env.

# SQLite file. Relative paths resolve from apps/api/prisma/, so this is
# apps/api/prisma/data/estuary.db. The file and its -wal/-shm siblings are gitignored.
DATABASE_URL="file:./data/estuary.db"

# API listen port.
PORT=4000

# Loopback for local development. Without API_TOKEN there is no access control
# at all, so binding 0.0.0.0 on a laptop publishes full task CRUD to the LAN.
# The container overrides this to 0.0.0.0, which is where it is actually needed.
HOST=127.0.0.1

# development | test | production. Does NOT control seeding — see ALLOW_SEED.
NODE_ENV=development

# Comma-separated CORS allow-list. Four origins because a browser sees four:
# localhost and 127.0.0.1 are different origins, and 5173 (vite dev) and 4173
# (vite preview — the production build) are different ports. Listing fewer is
# what made the preview build unable to reach the API.
#
# The Docker stack does not rely on this: nginx proxies /api/ to the API on the
# same origin, so nothing the app does is cross-origin there — and neither is
# Swagger UI, whose OpenAPI document declares `servers: [{ url: "/" }]` and so
# resolves "try it out" against whichever origin served /docs. Neither does the
# E2E suite: it starts its own API on its own port and sets this variable itself
# (see e2e/env.ts).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# `true` permits seeding even under NODE_ENV=production. The switch is this
# variable, not NODE_ENV, so the Docker image can ship demo data from a
# production build. Outside production no flag is needed. Seeding DELETES every
# task and comment first. Unset by default.
# ALLOW_SEED=true

# Container entrypoint only: seed after `migrate deploy`, but only when the
# task table is empty.
SEED_ON_START=false

# debug | info | warn | error
LOG_LEVEL=info

# Set false to hide Swagger UI at /docs. When false the router is never mounted
# and /docs is an ordinary 404 NOT_FOUND.
DOCS_ENABLED=true

# Over-limit request bodies become PAYLOAD_TOO_LARGE.
BODY_LIMIT=1mb

# Optional shared secret. When set, every /api/v1 request must send
# `Authorization: Bearer <API_TOKEN>` or gets 401 UNAUTHORIZED; /health and
# /docs stay open. At least 16 characters. Unset = no check (fine on localhost,
# wrong on any network you do not control). One token for every caller — who
# did what is still the X-Actor header.
# API_TOKEN=

# Whether an `agent:` actor may move a task to done. Off by default: agents hand
# finished work to needs_qa and a human closes it (ACTOR_NOT_PERMITTED otherwise).
AGENTS_MAY_COMPLETE=false

# Claim lease length in minutes (1–1440). A claim not renewed by a heartbeat or
# a write from its holder expires, and the task becomes claimable by anyone.
CLAIM_LEASE_MINUTES=30

# Days a task stays done before the API deletes it automatically (0–3650).
# Swept at boot and every six hours, counting from when it was completed.
# 0 turns the sweep off; POST /tasks/cleanup still works.
DONE_RETENTION_DAYS=90

# Optional GitHub integration (docs/features/GitHub_Integration.md). Off unless
# GITHUB_TOKEN and/or GITHUB_WEBHOOK_SECRET is set — no accounts, no OAuth app,
# just server-level config. Never logged, never echoed on a response.

# Fine-grained PAT / GitHub App token for read calls (link status, issue
# import). Without it, calls are anonymous — public repos only, 60 req/h.
# GITHUB_TOKEN=

# Enables POST /integrations/github/webhook. GitHub signs each delivery with
# this secret; a missing or wrong X-Hub-Signature-256 is 401
# INVALID_WEBHOOK_SIGNATURE. At least 16 characters.
# GITHUB_WEBHOOK_SECRET=

# GitHub Enterprise base URL. Defaults to the public API.
GITHUB_API_URL=https://api.github.com
