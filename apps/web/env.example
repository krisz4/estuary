# apps/web — copy to `.env` and adjust. Keep in sync with
# docs/engineering/ENVIRONMENT_VARIABLES.md.
#
# Vite only exposes variables prefixed VITE_ to client code. Anything else is
# silently `undefined` in the browser, which is a very quiet failure mode.
#
# These are inlined into the bundle at BUILD time, not read at runtime — so a
# Docker image built with one value cannot be re-pointed by changing the
# container's environment; it has to be rebuilt.

# API root, including the /api/v1 prefix.
#
# This must be the BROWSER-reachable URL, and never the compose service name
# (http://api:4000/...): the request is issued by the user's browser, which
# cannot resolve a compose network alias.
#
# Locally that is the absolute URL below. In Docker it is the RELATIVE path
# `/api/v1` (set as a build arg in docker-compose.yml): nginx serves the app and
# proxies /api/ to the API container, so the browser talks to one origin and no
# request is cross-origin.
#
# Whatever origin the browser loads this app from must also appear in the API's
# ALLOWED_ORIGINS, or every request fails preflight. `localhost` and `127.0.0.1`
# are different origins to a browser, and so are ports 5173 and 4173 — the API
# lists all four by default.
VITE_API_BASE_URL=http://localhost:4000/api/v1
