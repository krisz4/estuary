# apps/mcp — the task manager MCP server. Keep in sync with
# docs/engineering/ENVIRONMENT_VARIABLES.md § apps/mcp; src/config.ts parses these.
#
# Claude Code passes these from the MCP configuration that starts the server
# (the root .mcp.json, `claude mcp add -e`, or the plugin's options); the server
# does not read a .env file itself. For a manual run:
#   node --env-file=apps/mcp/.env apps/mcp/dist/index.js

# API root, including /api/v1. A self-hosted server: https://tasks.example.com/api/v1
TASKS_API_URL=http://localhost:4000/api/v1

# Actor attribution is stable per checkout. TASKS_CLIENT defaults to claude-code.
# Unset TASKS_ACTOR: agent:<client>@<project>[/<worktree>].
# TASKS_CLIENT=codex
# TASKS_ACTOR=agent:codex

# Claim ownership is separate from actor attribution. Unset: a random UUID per
# MCP process. To resume after a restart, reuse the original session id.
# Use a different id for every concurrent session; never share one.
# TASKS_SESSION_ID=

# Only when the API runs with API_TOKEN set; must equal it. Sent as a Bearer token.
# TASKS_API_TOKEN=

# Project for task_create / task_next calls that name none. Unset, the first valid
# slug of: the repo name of `git remote get-url origin`; the main checkout's
# directory name (the same from every worktree); the project directory's name
# (Claude Code sets CLAUDE_PROJECT_DIR for the server; git runs there).
# TASKS_DEFAULT_PROJECT=estuary
